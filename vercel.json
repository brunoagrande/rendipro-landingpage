{
  "redirects": [
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/termos",
      "destination": "https://app.rendipro.com.br/termos",
      "permanent": true
    },
    {
      "source": "/privacidade",
      "destination": "https://app.rendipro.com.br/privacidade",
      "permanent": true
    },
    {
      "source": "/:nome((?!assets$|screenshots$|termos$|privacidade$|ig$|i$|editais$|planos$|precos$|blog$|app$|login$|assinar$)[a-zA-Z0-9-]+)",
      "destination": "/?utm_source=parceiro&utm_medium=influencer&utm_campaign=:nome",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
