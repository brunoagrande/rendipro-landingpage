{
  "redirects": [
    {
      "source": "/termos",
      "destination": "https://app.rendipro.com.br/termos",
      "permanent": true
    },
    {
      "source": "/privacidade",
      "destination": "https://app.rendipro.com.br/privacidade",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
